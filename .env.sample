# Required Telegram bot token from BotFather
TELEGRAM_BOT_TOKEN=

# Required MongoDB connection string for users, watchlists, alerts, and cached market data
MONGODB_URI=

# Optional fallback provider key. If missing, the bot still runs with CoinGecko and cached data.
COINMARKETCAP_API_KEY=

# Optional tuning values with safe defaults
ALERT_POLL_MS=60000
MARKET_TIMEOUT_MS=10000
PRICE_CACHE_TTL_MS=45000
SYMBOL_CACHE_TTL_MS=21600000
